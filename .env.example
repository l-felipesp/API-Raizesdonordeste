# Copie este arquivo para ".env" e preencha com os seus valores locais.
# O arquivo .env NAO deve ser versionado (ja esta no .gitignore).

DB_URL=jdbc:postgresql://localhost:5432/raizes_nordeste
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_do_postgres

# Minimo de 32 caracteres (exigencia do algoritmo HS256)
JWT_SECRET=troque-por-uma-string-aleatoria-com-32-ou-mais-caracteres
JWT_EXPIRATION_MS=3600000

# Locais das migrations do Flyway. Padrao: estrutura + dados de teste (seed).
# Em producao, descomente a linha abaixo para NAO carregar os dados de teste.
# FLYWAY_LOCATIONS=classpath:db/migration
